{
  "name": "Transcritor de Áudio",
  "short_name": "Transcritor",
  "description": "Transcreve áudios (WhatsApp, reuniões, aulas) direto no aparelho.",
  "lang": "pt-BR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f6f5",
  "theme_color": "#0f5132",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "audio", "accept": ["audio/*", "application/ogg", ".ogg", ".opus", ".oga", ".mp3", ".m4a", ".aac", ".wav", ".amr", "video/mp4"] }
      ]
    }
  }
}
